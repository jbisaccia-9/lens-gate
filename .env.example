# Copy to .env and fill in. .env is gitignored; never commit real values.
# Use letters and digits only for passwords (they are interpolated into SQL by the init script).

# --- docker compose: warehouse and Metabase app DB ---
LENSGATE_PG_SUPERUSER=lensgate
LENSGATE_PG_SUPERUSER_PASSWORD=
LENSGATE_PG_WH_SALES_PASSWORD=
LENSGATE_PG_WH_OPS_PASSWORD=
LENSGATE_PG_WH_PEOPLE_PASSWORD=
LENSGATE_PG_WH_FINANCE_PASSWORD=
LENSGATE_PG_WH_EXEC_PASSWORD=
LENSGATE_MB_APPDB_PASSWORD=
LENSGATE_MB_VERSION=v0.64.1

# --- provision / sync only ---
# Pass these inline to `provision` and `sync --metabase`. Never export them in the
# shell that runs `serve` or `mcp`: both refuse to start if an admin credential is visible.
LENSGATE_MB_ADMIN_EMAIL=
LENSGATE_MB_ADMIN_PASSWORD=
# The shared password `sync --apply` gives the six fictional demo users.
LENSGATE_DEMO_PASSWORD=
# How provision reaches the warehouse from inside the Metabase container.
LENSGATE_PG_HOST=warehouse
LENSGATE_PG_PORT=5432
LENSGATE_PG_DB=larkmoor
# Set to 1 on a paid Metabase plan to use "blocked" view-data permissions.
LENSGATE_MB_PRO=

# --- chat panel / MCP: the model ---
# scripted (default, no key) | anthropic | foundry
LENSGATE_PROVIDER=scripted
ANTHROPIC_API_KEY=
LENSGATE_ANTHROPIC_MODEL=
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=
AZURE_AI_FOUNDRY_API_VERSION=

# --- identity: leave blank to use the dev IdP in data/idp ---
LENSGATE_ENTRA_TENANT_ID=
LENSGATE_ENTRA_AUDIENCE=

# --- MCP server (live): the person's OWN Metabase login and ID token ---
LENSGATE_METABASE_URL=
LENSGATE_MB_EMAIL=
LENSGATE_MB_PASSWORD=
LENSGATE_ID_TOKEN=
